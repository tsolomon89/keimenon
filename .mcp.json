{
  "mcpServers": {
    "keimenon-database": {
      "command": "node",
      "args": [".mcp/servers/database/index.js"],
      "env": {
        "SQLITE_PATH": "${HOME}/.keimenon/keimenon.db"
      }
    },
    "keimenon-docs": {
      "command": "node",
      "args": [".mcp/servers/docs/index.js"]
    },
    "keimenon-api-testing": {
      "command": "node",
      "args": [".mcp/servers/api-testing/index.js"],
      "env": {
        "API_BASE_URL": "http://localhost:4001"
      }
    },
    "keimenon-chat-import": {
      "command": "node",
      "args": [".mcp/servers/chat-import/index.js"],
      "env": {
        "API_BASE_URL": "http://localhost:4001"
      }
    },
    "keimenon-settings-crm": {
      "command": "node",
      "args": [".mcp/servers/settings-crm/index.js"],
      "env": {
        "SQLITE_PATH": "${HOME}/.keimenon/keimenon.db"
      }
    },
    "playwright-e2e": {
      "command": "node",
      "args": [".mcp/servers/playwright-e2e/index.js"],
      "env": {
        "BASE_URL": "http://localhost:3000",
        "API_BASE_URL": "http://localhost:4001",
        "TEST_USER_EMAIL": "admin@admin.com",
        "TEST_USER_PASSWORD": "admin123"
      }
    },
    "visual-feedback": {
      "command": "node",
      "args": [".mcp/servers/visual-feedback/index.js"],
      "description": "Visual testing and screenshot comparison for E2E test automation"
    },
    "playwright-test": {
      "command": "cmd",
      "args": ["/c", "npx", "playwright", "run-test-mcp-server"]
    },
    "mui": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@mui/mcp@latest"],
      "description": "Official Material UI MCP server - components, theming, and documentation"
    },
    "vercel": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@vercel/mcp@latest"],
      "description": "Official Vercel MCP server - deployments, projects, and AI SDK docs"
    },
    "lean-lsp": {
      "command": "cmd",
      "args": ["/c", "uvx", "lean-lsp-mcp"],
      "description": "Lean 4 theorem prover via LSP - diagnostics, goal states, theorem search"
    },
    "coq-rocq": {
      "command": "cmd",
      "args": ["/c", "uvx", "mcp-rocq"],
      "description": "Coq/Rocq proof assistant - dependent type checking, inductive types, property proving"
    }
  }
}
