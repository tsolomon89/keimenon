{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "The final assistant response text."
    },
    "evidence_used": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "An array of evidence IDs cited in the response."
    },
    "proposed_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["ProposedClaim", "ProposedSource", "Gap", "CitationIssue"] }
        }
      },
      "description": "Optional list of proposed graph outputs like Gaps or Claims."
    }
  },
  "required": ["content", "evidence_used"]
}
