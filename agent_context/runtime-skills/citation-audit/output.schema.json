{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "The assistant's response to the user."
    },
    "proposed_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "const": "CitationIssue" },
          "claim_id": { "type": "string" },
          "issue": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "confidence": { "type": "number" },
          "reasoning": { "type": "string" }
        },
        "required": ["kind", "issue"]
      }
    }
  },
  "required": ["content", "proposed_outputs"]
}
