{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "meta": {
    "version": "2025-11-04",
    "generated_at": "2025-11-04T00:00:00Z",
    "maintainer": "Agent Architecture WG"
  },
  "limits_policy": {
    "description": "Default concurrency, queueing, and failure handling rules applied to all agents.",
    "concurrency": {
      "global_max": 12,
      "per_board_max": 3,
      "per_agent_defaults": {
        "gatherer_v1": 1,
        "autogrouper_v1": 2,
        "extractor_v1": 2,
        "verifier_v1": 2,
        "synthesizer_v1": 3,
        "planner_v1": 2,
        "workflow_runner_v1": 1,
        "objectivity_monitor_v1": 1
      }
    },
    "queueing": {
      "ordering": "FIFO_PER_BOARD",
      "business_priority_weight": 2,
      "default_queue": "board_fifo",
      "business_queue": "business_priority"
    },
    "backoff": {
      "initial_seconds": 15,
      "max_seconds": 900,
      "multiplier": 2,
      "jitter": "full"
    },
    "dead_letter": {
      "enabled": true,
      "path": "state/agent_errors.log",
      "retention_days": 14
    }
  },
  "objectivity_thresholds": {
    "A": {
      "label": "Objective",
      "min_score": 0.92,
      "refresh_interval_hours": 168,
      "description": "Claims supported by primary sources and at least one passing verifier run."
    },
    "B": {
      "label": "Needs Review",
      "min_score": 0.8,
      "refresh_interval_hours": 72,
      "description": "Claims with mixed evidence or pending verification; requires follow-up tasks."
    },
    "C": {
      "label": "Unverified",
      "min_score": 0,
      "refresh_interval_hours": 24,
      "description": "Claims lacking verification or flagged as contested."
    }
  },
  "verification_budget": {
    "free": {
      "per_run": {
        "max_tokens": 2500,
        "max_cost_usd": 0,
        "max_verifier_runs": 0,
        "timeout_s": 60
      },
      "per_day": {
        "max_tokens": 5000,
        "max_cost_usd": 0,
        "max_verifier_runs": 0
      }
    },
    "pro": {
      "per_run": {
        "max_tokens": 8000,
        "max_cost_usd": 1.5,
        "max_verifier_runs": 6,
        "timeout_s": 120
      },
      "per_day": {
        "max_tokens": 32000,
        "max_cost_usd": 6,
        "max_verifier_runs": 24
      }
    },
    "business": {
      "per_run": {
        "max_tokens": 15000,
        "max_cost_usd": 4,
        "max_verifier_runs": 12,
        "timeout_s": 180
      },
      "per_day": {
        "max_tokens": 60000,
        "max_cost_usd": 18,
        "max_verifier_runs": 60
      }
    }
  },
  "gatherer_sources_allowlist": {
    "priority_domains": [
      "arxiv.org",
      "doi.org",
      "nature.com",
      "science.org",
      "github.com",
      "docs.microsoft.com",
      "developer.mozilla.org"
    ],
    "registries": ["npmjs.com", "pypi.org", "crates.io"],
    "business_overrides": {
      "enabled": true,
      "requires_approval": true
    }
  },
  "pii_guardrails": {
    "applies_to": ["business"],
    "redactions": {
      "email": "{{EMAIL_REDACTED}}",
      "phone": "{{PHONE_REDACTED}}",
      "ip_address": "{{IP_REDACTED}}",
      "account_id": "{{ACCOUNT_REDACTED}}"
    },
    "logging": {
      "allow_raw": false,
      "allowed_fields": ["scope_id", "receipt_id", "event_level"],
      "storage": "state/"
    },
    "data_retention_days": 30
  },
  "tier_rules": {
    "free": {
      "enabled_agents": ["autogrouper_v1", "extractor_v1", "synthesizer_v1", "planner_v1"],
      "model_usage": {
        "local_first": true,
        "hosted_opt_in": false
      },
      "workflow_runner_allowed": false,
      "gatherer_allowed": false,
      "verifier_allowed": false
    },
    "pro": {
      "enabled_agents": [
        "autogrouper_v1",
        "extractor_v1",
        "synthesizer_v1",
        "planner_v1",
        "gatherer_v1",
        "verifier_v1",
        "objectivity_monitor_v1"
      ],
      "model_usage": {
        "local_first": true,
        "hosted_opt_in": true
      },
      "workflow_runner_allowed": false,
      "gatherer_allowed": true,
      "verifier_allowed": true
    },
    "business": {
      "enabled_agents": [
        "autogrouper_v1",
        "extractor_v1",
        "synthesizer_v1",
        "planner_v1",
        "gatherer_v1",
        "verifier_v1",
        "workflow_runner_v1",
        "objectivity_monitor_v1"
      ],
      "model_usage": {
        "local_first": true,
        "hosted_opt_in": true
      },
      "workflow_runner_allowed": true,
      "gatherer_allowed": true,
      "verifier_allowed": true
    }
  },
  "operational_ethos_enforcement": {
    "description": "Operational ethos encoding per CLAUDE.md Section 13",
    "version": "1.0.0",
    "completeness_requirements": {
      "feature_implementation": {
        "required_layers": ["backend", "frontend", "ui_ux", "tests", "docs"],
        "layer_definitions": {
          "backend": {
            "must_have": ["api_endpoint", "database_operation", "business_logic", "error_handling"],
            "validation": "All backend components present and tested"
          },
          "frontend": {
            "must_have": [
              "react_component",
              "state_management",
              "api_integration",
              "form_validation"
            ],
            "validation": "Component renders and integrates with backend"
          },
          "ui_ux": {
            "must_have": ["visual_design", "accessibility", "responsive_design", "user_feedback"],
            "validation": "ARIA compliant, mobile responsive, loading states present"
          },
          "tests": {
            "must_have": ["e2e_tests", "unit_tests", "integration_tests", "multi_tenant_tests"],
            "validation": "Coverage >90%, @smoke tags present, isolation verified"
          },
          "docs": {
            "must_have": ["api_docs", "architecture_notes", "todo_comments", "user_docs"],
            "validation": "Documentation updated, cross-references added"
          }
        },
        "enforcement": "strict",
        "failure_action": "mark_incomplete"
      },
      "code_quality": {
        "security_check": true,
        "multi_tenant_isolation": true,
        "error_handling": true,
        "performance_review": true
      },
      "testing": {
        "e2e_coverage": 0.9,
        "unit_coverage": 0.9,
        "isolation_required": true,
        "data_tag_required": "test"
      },
      "documentation": {
        "todo_format": "vscode_compatible",
        "citation_required": true,
        "cross_reference_required": true
      },
      "schema_compliance": {
        "validation_required": true,
        "fingerprinting_required": ["Source", "CodeBlock"],
        "edge_semantics_verified": true
      },
      "architecture": {
        "rollback_plan_required": true,
        "extensibility_required": true,
        "graph_native_required": true
      }
    },
    "anticipatory_planning": {
      "required_questions": [
        "scale_10x",
        "extension_6months",
        "edge_cases",
        "security_boundaries",
        "observability"
      ],
      "question_definitions": {
        "scale_10x": "What breaks when this scales 10x or 100x?",
        "extension_6months": "How does this feature extend in 6 months?",
        "edge_cases": "What edge cases am I missing?",
        "security_boundaries": "Where are the trust boundaries?",
        "observability": "How will we know if this is broken?"
      },
      "enforcement": "mandatory",
      "incomplete_design_action": "stop_and_research"
    },
    "context_consolidation_strategy": {
      "description": "Automatic context consolidation per CLAUDE.md Section 13.0",
      "techniques": [
        "task_agent_spawning",
        "incremental_summarization",
        "schema_driven_state",
        "receipt_based_continuation"
      ],
      "triggers": {
        "token_threshold": 0.8,
        "complexity_threshold": "high",
        "multi_phase_task": true
      },
      "actions": {
        "spawn_task_agent": {
          "when": "tokens > 160k or complexity=high or description_match",
          "fresh_budget": 200000,
          "separate_context_window": true,
          "context_inheritance": "none",
          "context_passing": "explicit_via_prompt",
          "resume_capability": "agent_id"
        },
        "write_summary": {
          "when": "phase_complete",
          "location": "ai_context/state/",
          "format": "schema_validated_json",
          "include_receipt_id": true
        },
        "chain_receipts": {
          "when": "multi_agent_workflow",
          "format": "receipt_chain",
          "continuity": "maintained"
        }
      },
      "never_say": ["context limit reached without consolidation attempt"],
      "always_try": ["task_agent_spawn", "incremental_summary", "state_persistence"]
    },
    "recursive_intelligence": {
      "post_task_actions": [
        "update_todos",
        "add_cross_references",
        "update_documentation",
        "propose_schema_extensions",
        "generate_followup_tasks"
      ],
      "checklist_required": true,
      "enrichment_mandatory": true,
      "compliance_validation": "self_test"
    },
    "enforcement_rules": {
      "ethos_violations": {
        "user_reference_required": "CLAUDE.md Section 13.X",
        "agent_must_acknowledge": true,
        "correction_required": true,
        "new_baseline": "corrected_behavior"
      },
      "user_override_requests": {
        "agent_must_explain_violation": true,
        "propose_compliant_alternative": true,
        "if_user_insists": "acknowledge_and_flag_technical_debt"
      },
      "non_negotiable": true,
      "system_integrity_protected": true
    },
    "task_agent_constraints": {
      "architecture": "flat_only",
      "spawning_source": "main_agent_only",
      "max_concurrent_agents": 3,
      "cold_start_context_rebuild": true,
      "resume_via_agent_id": true,
      "spawn_conditions": {
        "complexity": "when single agent insufficient",
        "scope": "when scope exceeds single agent budget",
        "isolation": "when subtask can run independently",
        "description_match": "when task description matches agent capabilities"
      },
      "constraints": {
        "no_recursive_spawning": true,
        "flat_hierarchy_only": true,
        "separate_context_windows": true
      },
      "escalation": {
        "max_concurrent_exceeded": "queue_or_wait",
        "budget_exhausted": "write_state_and_propose_continuation",
        "complexity_unmanageable": "request_human_decomposition"
      }
    }
  }
}
