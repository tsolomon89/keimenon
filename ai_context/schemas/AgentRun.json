{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ai_context/schemas/AgentRun.json",
  "title": "AgentRunEnvelope",
  "description": "Canonical representation of an agent execution run including receipts, artifacts, and events.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run"],
  "properties": {
    "run": {
      "$ref": "#/$defs/AgentRun"
    }
  },
  "$defs": {
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens", "max_cost_usd", "timeout_s"],
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ts", "level", "msg"],
      "properties": {
        "ts": {
          "type": "number",
          "description": "Epoch timestamp in seconds."
        },
        "level": {
          "type": "string",
          "enum": ["info", "warn", "error"]
        },
        "msg": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "ErrorDetail": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "AgentRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "agent_id",
        "scope_id",
        "budget",
        "plan",
        "artifacts",
        "events",
        "status",
        "started_at"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{6,64}$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 3
        },
        "scope_id": {
          "type": "string",
          "minLength": 3
        },
        "receipt_id": {
          "type": "string",
          "minLength": 3
        },
        "receipt": {
          "type": "string",
          "minLength": 3
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          }
        },
        "status": {
          "type": "string",
          "enum": ["success", "error", "partial"]
        },
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        },
        "budget_events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ts", "kind"],
            "properties": {
              "ts": {
                "type": "number"
              },
              "kind": {
                "type": "string",
                "enum": ["throttle", "overrun", "recovered"]
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "started_at": {
          "type": "number",
          "description": "Epoch timestamp when execution began."
        },
        "completed_at": {
          "type": "number",
          "description": "Epoch timestamp when execution completed."
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": ["receipt_id"]
        },
        {
          "required": ["receipt"]
        }
      ]
    }
  }
}
