# Server
PORT=4001
NODE_ENV=development

# ====================
# STORAGE MODE
# ====================
# Choose: local (SQLite only), canvas (Neo4j only), or hybrid (both)
# DEFAULT: local (100% local, no cloud required!)
STORAGE_MODE=local

# ====================
# LOCAL STORAGE (SQLite + Files)
# ====================
# Where all your data lives - completely local!
LOCAL_DOCS_PATH=~/.canvas-memory
SQLITE_PATH=~/.canvas-memory/canvas.db

# File storage for uploads
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=10

# ====================
# OPTIONAL: Neo4j (Only if STORAGE_MODE=canvas or hybrid)
# ====================
# Uncomment these if you want graph database features:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password

# ====================
# OPTIONAL: User's AI API Keys (Bring Your Own)
# ====================
# Uncomment and add your keys if you want AI features:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ====================
# Auth (placeholder for future)
# ====================
JWT_SECRET=your_secret_key_here

# ====================
# Limits (Free tier)
# ====================
FREE_MAX_SOURCES=500
FREE_MAX_NODES=20000
FREE_MAX_GROUPS=50
FREE_STORAGE_GB=5
