# =============================================================================
# Keimenon OS - API Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env files to version control!
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION (Required)
# =============================================================================
PORT=4001
NODE_ENV=development  # Options: development, production, test

# =============================================================================
# STORAGE MODE (Required)
# =============================================================================
# Options: local
STORAGE_MODE=local
RAW_STORAGE_MODE=local_only

# =============================================================================
# LOCAL STORAGE (Required)
# =============================================================================
# Path where user data and documents are stored
# Windows example: C:\Users\YourName\.keimenon
# Linux/Mac example: ~/.keimenon or /home/yourname/.keimenon
LOCAL_DOCS_PATH=~/.keimenon

# SQLite database file path
# Windows example: C:\Users\YourName\.keimenon\keimenon.db
# Linux/Mac example: ~/.keimenon/keimenon.db
SQLITE_PATH=~/.keimenon/keimenon.db

# File storage path for uploads
STORAGE_PATH=./storage

# Maximum file upload size in megabytes
MAX_FILE_SIZE_MB=10

# =============================================================================
# SECURITY (Required for Production)
# =============================================================================
# JWT Secret - MUST be changed in production!
# Generate a strong secret: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your_secret_key_here_CHANGE_IN_PRODUCTION

# Allowed CORS origins (comma-separated)
# Production ONLY - Development allows localhost automatically
# Example: https://yourdomain.com,https://app.yourdomain.com
# ALLOWED_ORIGINS=

# =============================================================================
# USER AI API KEYS (Optional - Bring Your Own Keys)
# =============================================================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# TIER LIMITS (Optional - Defaults provided)
# =============================================================================
# Free tier limits
FREE_MAX_SOURCES=500
FREE_MAX_NODES=20000
FREE_MAX_GROUPS=50
FREE_STORAGE_GB=5

# Professional tier limits (Optional)
# PRO_MAX_SOURCES=5000
# PRO_MAX_NODES=200000
# PRO_MAX_GROUPS=500
# PRO_STORAGE_GB=50

# Business tier limits (Optional)
# BUSINESS_MAX_SOURCES=unlimited
# BUSINESS_MAX_NODES=unlimited
# BUSINESS_MAX_GROUPS=unlimited
# BUSINESS_STORAGE_GB=unlimited

# =============================================================================
# LOGGING & MONITORING (Optional - Defaults provided)
# =============================================================================
# Log level: error, warn, info, debug, verbose
# LOG_LEVEL=info

# Enable request logging
# REQUEST_LOGGING=true

# Audit log retention days (GDPR compliance)
# AUDIT_LOG_RETENTION_DAYS=90

# =============================================================================
# ERROR TRACKING (Optional - Privacy-respecting, opt-in only)
# =============================================================================
# Sentry DSN for error tracking (leave empty to disable)
# Get your DSN from: https://sentry.io or self-hosted Sentry
# SENTRY_DSN=

# Sentry environment (development, staging, production)
# SENTRY_ENVIRONMENT=production

# Sample rate for error events (0.0 to 1.0)
# 1.0 = send all errors, 0.5 = send 50% of errors
# SENTRY_SAMPLE_RATE=1.0

# Sample rate for performance traces (0.0 to 1.0)
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Enable Sentry profiling (requires @sentry/profiling-node)
# SENTRY_PROFILING_ENABLED=false

# Scrub sensitive data before sending to Sentry
# SENTRY_SCRUB_PII=true

# =============================================================================
# RATE LIMITING (Optional - Defaults in code)
# =============================================================================
# Login attempts per 15 minutes
# AUTH_RATE_LIMIT=5

# Registration attempts per hour
# REGISTRATION_RATE_LIMIT=5

# API requests per minute (general)
# API_RATE_LIMIT=100

# =============================================================================
# ACCOUNT LOCKOUT (Optional - Defaults in code)
# =============================================================================
# Maximum failed login attempts before lockout
# MAX_LOGIN_ATTEMPTS=5

# Lockout duration in minutes
# LOCKOUT_DURATION_MINUTES=30

# Window to count attempts in minutes
# LOGIN_ATTEMPT_WINDOW_MINUTES=15

# =============================================================================
# EMAIL (Optional - For future features)
# =============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@yourdomain.com

# =============================================================================
# THIRD-PARTY INTEGRATIONS (Optional - For future features)
# =============================================================================
# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=

# =============================================================================
# DEVELOPMENT ONLY (Optional)
# =============================================================================
# Enable debug mode
# DEBUG=true

# Skip authentication (NEVER use in production!)
# SKIP_AUTH=false

# Mock data generation
# GENERATE_MOCK_DATA=false

# =============================================================================
# IMPORT SYSTEM FLAGS (Optional - Development & Debugging)
# =============================================================================
# Enable legacy import routes (default: disabled)
# WARNING: Legacy routes have known issues and are deprecated
ENABLE_LEGACY_IMPORTS=0

# Enable import method debug selector UI (default: disabled)
# Shows dropdown to test different import paths during development
DEBUG_IMPORT_SELECTOR=0

# =============================================================================
# GATE-E KILL SWITCHES (Optional - Rollback Controls)
# =============================================================================
# Disable objective verification enqueue from import worker (default: off)
# When enabled, imports still complete but OBJECTIVE_QUEUE task dispatch is skipped.
KILL_SWITCH_OBJECTIVE_ENQUEUE=0

# Disable semantic component of SimilarityEngineV2 (default: off)
# When enabled, lexical/structural/flow remain active with deterministic reweighting.
KILL_SWITCH_SIMILARITY_SEMANTIC_STAGE=0

# =============================================================================
# IMPORT SYSTEM TIMEOUTS (Optional - Performance & Reliability)
# =============================================================================
# Maximum duration for a single import job worker execution (milliseconds)
# Default: 600000 (10 minutes) - Prevents indefinite import hangs
# Increase for very large imports (>100MB files, >50k messages)
IMPORT_WORKER_TIMEOUT_MS=600000

# Maximum duration for file upload (milliseconds)
# Default: 300000 (5 minutes) - Allows large files on slower connections
# Increase for slower networks or files >100MB
UPLOAD_TIMEOUT_MS=300000

# Circuit breaker auto-reset timeout (milliseconds)
# Default: 30000 (30 seconds) - How long circuit stays open after failures
# Circuit breaker opens after 3 consecutive database write failures
CIRCUIT_BREAKER_RESET_MS=30000

# Maximum wait time for blocked jobs (milliseconds)
# Default: 120000 (2 minutes) - Auto-fail jobs blocked by concurrency limits
# Jobs waiting longer than this will be marked as failed
JOB_BLOCKED_MAX_WAIT_MS=120000

# SSE heartbeat interval (milliseconds)
# Default: 15000 (15 seconds) - Keep-alive for Server-Sent Events
# Reduced from 30s for faster disconnect detection
SSE_HEARTBEAT_INTERVAL_MS=15000

# =============================================================================
# WORKER POOL CONFIGURATION (Optional - Concurrency Control)
# =============================================================================
# Maximum number of concurrent import jobs
# Default: 3 - Balance between throughput and resource usage
MAX_CONCURRENT_JOBS=3

# Worker poll interval for checking queued jobs (milliseconds)
# Default: 5000 (5 seconds) - How often to check for new jobs
WORKER_POLL_INTERVAL_MS=5000
