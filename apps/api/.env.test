# Test Environment Configuration
PORT=4001
NODE_ENV=test
STORAGE_MODE=local
LOCAL_DOCS_PATH=~/.keimenon
SQLITE_PATH=~/.keimenon/keimenon.db
DB_PATH=~/.keimenon/keimenon.db
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=10
JWT_SECRET=test_jwt_secret_key_for_testing_only
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4001
MAX_CONCURRENT_JOBS=2
WORKER_POLL_INTERVAL_MS=1000
SSE_BROADCAST_INTERVAL_MS=500
SSE_HEARTBEAT_INTERVAL_MS=30000
DISABLE_RATE_LIMIT=1
TEST_API_URL=http://localhost:4001
