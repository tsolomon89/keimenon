{
  "name": "@canvas-memory/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:e2e": "node --import tsx --test src/__tests__/e2e-import-delete.test.ts",
    "test:integration": "node tests/integration/run-tests.js",
    "test:watch": "node --import tsx --test --watch src/**/*.test.ts",
    "test:coverage": "c8 --reporter=lcov --reporter=text node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@canvas-memory/db": "*",
    "@canvas-memory/parsers": "*",
    "@canvas-memory/types": "*",
    "@sentry/node": "^10.20.0",
    "@sentry/profiling-node": "^10.20.0",
    "@types/busboy": "^1.5.4",
    "busboy": "^1.6.0",
    "clarinet": "^0.12.6",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "JSONStream": "^1.3.5",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.7",
    "neo4j-driver": "^5.19.0",
    "zod": "^3.23.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/eventsource": "^1.1.15",
    "@types/express": "^4.17.21",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/node-fetch": "^2.6.13",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "axios": "^1.12.2",
    "c8": "^9.0.0",
    "eslint": "^8.57.0",
    "eventsource": "^4.0.0",
    "form-data": "^4.0.4",
    "node-fetch": "^2.7.0",
    "supertest": "^6.3.3",
    "tsx": "^4.7.2",
    "typescript": "^5.3.3"
  }
}
