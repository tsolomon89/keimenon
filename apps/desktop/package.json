{
  "name": "keimenon-desktop",
  "version": "0.1.0",
  "description": "Keimenon Desktop App",
  "author": "Keimenon Team",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run build:dist",
    "postinstall": "electron-builder install-app-deps",
    "dev": "tsc -w",
    "electron:dev": "tsc && electron .",
    "start": "electron .",
    "clean": "rimraf dist out",
    "type-check": "tsc --noEmit",
    "make": "npm run build:dist && npm run package -- --win",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "build:dist": "tsc",
    "package": "electron-builder"
  },
  "dependencies": {
    "@keimenon/api": "*",
    "@keimenon/db": "*",
    "@keimenon/parsers": "*",
    "@keimenon/types": "*",
    "better-sqlite3": "^12.6.2",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^5.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "keytar": "^7.9.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.0",
    "@types/uuid": "^10.0.0",
    "@types/verror": "^1.10.11",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "electron": "28.2.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  },
  "build": {
    "appId": "com.keimenon.desktop",
    "productName": "Keimenon",
    "directories": {
      "output": "out"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ]
  }
}
