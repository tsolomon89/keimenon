# ====================
# API Configuration
# ====================
# Local API server (runs on your machine)
NEXT_PUBLIC_API_URL=http://localhost:4001

# ====================
# Storage Mode (must match backend)
# ====================
NEXT_PUBLIC_STORAGE_MODE=local

# ====================
# Auth (placeholder for future)
# ====================
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_AUTH_CLIENT_ID=

# ====================
# Feature Flags
# ====================
# FREE TIER: Basic local features (no AI)
NEXT_PUBLIC_ENABLE_PRO_FEATURES=false
NEXT_PUBLIC_ENABLE_BUSINESS_FEATURES=false

# ====================
# Error Tracking (Optional - Privacy-respecting, opt-in only)
# ====================
# Sentry DSN for error tracking (leave empty to disable)
# Get your DSN from: https://sentry.io or self-hosted Sentry
# NOTE: User must explicitly consent in settings before errors are sent
# NEXT_PUBLIC_SENTRY_DSN=

# Sentry environment (development, staging, production)
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Sample rate for error events (0.0 to 1.0)
# NEXT_PUBLIC_SENTRY_SAMPLE_RATE=1.0

# Sample rate for performance traces (0.0 to 1.0)
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Session replay sample rates (0.0 to 1.0)
# NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_REPLAY_ERROR_SAMPLE_RATE=1.0

# Scrub sensitive data before sending to Sentry
# NEXT_PUBLIC_SENTRY_SCRUB_PII=true

# ====================
# LOCAL-FIRST NOTES
# ====================
# This app runs 100% on your machine!
# - No cloud costs
# - Your data stays local
# - Bring your own API keys (optional)
# - Works offline (except AI features)
