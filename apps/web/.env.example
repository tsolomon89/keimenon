# ====================
# API Configuration
# ====================
# Local API server (runs on your machine)
NEXT_PUBLIC_API_URL=http://localhost:4001

# ====================
# Storage Mode (must match backend)
# ====================
NEXT_PUBLIC_STORAGE_MODE=local

# ====================
# Auth (placeholder for future)
# ====================
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_AUTH_CLIENT_ID=

# ====================
# Feature Flags
# ====================
# FREE TIER: Basic local features (no AI)
NEXT_PUBLIC_ENABLE_PRO_FEATURES=false
NEXT_PUBLIC_ENABLE_BUSINESS_FEATURES=false

# ====================
# Import System Flags (Development & Debugging)
# ====================
# Enable legacy import routes (default: disabled)
# WARNING: Legacy components have known issues and are deprecated
NEXT_PUBLIC_ENABLE_LEGACY_IMPORTS=0

# Enable hybrid local-first import fallback (default: disabled)
NEXT_PUBLIC_ENABLE_HYBRID_LOCAL_FIRST=0

# Enable 3D renderer controls (default: enabled)
# Set to false as a rollback kill switch to force 2D-only mode.
NEXT_PUBLIC_ENABLE_3D_RENDERER=true

# Enable import method debug selector UI (default: disabled)
# Shows dropdown to test different import paths during development
NEXT_PUBLIC_DEBUG_IMPORT_SELECTOR=0

# ====================
# E2E Testing
# ====================
# Disable welcome modal and other intrusive UI during E2E tests
# Set to true when running Playwright tests
NEXT_PUBLIC_E2E_TESTING=false

# ====================
# Import System Timeouts (Performance & Reliability)
# ====================
# Job status polling interval (milliseconds)
# Default: 2000 (2 seconds) - How often to check job status via API
NEXT_PUBLIC_JOB_POLL_INTERVAL_MS=2000

# SSE reconnection timeout (milliseconds)
# Default: 5000 (5 seconds) - Delay before attempting SSE reconnection
NEXT_PUBLIC_SSE_RECONNECT_TIMEOUT_MS=5000

# Maximum wait for job completion in UI (milliseconds)
# Default: 900000 (15 minutes) - Show timeout error if job runs longer
# Should be longer than backend IMPORT_WORKER_TIMEOUT_MS
NEXT_PUBLIC_MAX_JOB_WAIT_MS=900000

# ====================
# Error Tracking (Optional - Privacy-respecting, opt-in only)
# ====================
# Sentry DSN for error tracking (leave empty to disable)
# Get your DSN from: https://sentry.io or self-hosted Sentry
# NOTE: User must explicitly consent in settings before errors are sent
# NEXT_PUBLIC_SENTRY_DSN=

# Sentry environment (development, staging, production)
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Sample rate for error events (0.0 to 1.0)
# NEXT_PUBLIC_SENTRY_SAMPLE_RATE=1.0

# Sample rate for performance traces (0.0 to 1.0)
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Session replay sample rates (0.0 to 1.0)
# NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_REPLAY_ERROR_SAMPLE_RATE=1.0

# Scrub sensitive data before sending to Sentry
# NEXT_PUBLIC_SENTRY_SCRUB_PII=true

# ====================
# LOCAL-FIRST NOTES
# ====================
# This app runs 100% on your machine!
# - No cloud costs
# - Your data stays local
# - Bring your own API keys (optional)
# - Works offline (except AI features)
