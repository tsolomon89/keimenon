{
  "name": "keimenon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install && npm run check-ports && npm run prepare && echo \n✅ Setup complete! Run 'npm run dev' to start.",
    "dev": "node scripts/dev.js",
    "dev:clean": "node scripts/dev.js --clean",
    "dev:stop": "node scripts/dev-stop.js",
    "cleanup:dev": "node scripts/cleanup-dev.js",
    "dev:desktop": "node scripts/dev-desktop.js",
    "test": "node scripts/run-with-node22.js \"turbo run test --no-daemon --concurrency=1\"",
    "test:auth": "node scripts/run-with-node22.js \"node tests/auth-suite.js\"",
    "e2e": "node scripts/run-with-node22.js playwright test",
    "e2e:chromium": "node scripts/run-with-node22.js playwright test --project=chromium",
    "e2e:firefox": "node scripts/run-with-node22.js playwright test --project=firefox",
    "e2e:webkit": "node scripts/run-with-node22.js playwright test --project=webkit --workers=1",
    "e2e:smoke": "node scripts/run-with-node22.js playwright test tests/e2e/smoke.spec.ts tests/e2e/keimenon-operations.spec.ts tests/e2e/flow-auth-keimenon.spec.ts tests/e2e/settings-navigation.spec.ts --project=chromium --workers=2",
    "e2e:heavy": "node scripts/run-with-node22.js cross-env SQLITE_PATH=./e2e_heavy.db playwright test tests/e2e/scenarios/huge-file-upload.spec.ts --project=chromium --timeout=600000",
    "e2e:smoke:ui": "node scripts/run-with-node22.js playwright test tests/e2e/smoke.spec.ts tests/e2e/keimenon-operations.spec.ts tests/e2e/flow-auth-keimenon.spec.ts tests/e2e/settings-navigation.spec.ts --project=chromium --ui",
    "e2e:ui": "node scripts/run-with-node22.js playwright test --ui",
    "e2e:headed": "node scripts/run-with-node22.js playwright test --headed",
    "e2e:debug": "node scripts/run-with-node22.js playwright test --debug",
    "e2e:install": "node scripts/run-with-node22.js playwright install --with-deps",
    "e2e:report": "node scripts/run-with-node22.js playwright show-report",
    "e2e:dev": "node scripts/e2e/dev.js",
    "e2e:clean": "node scripts/cleanup-test-data.js",
    "e2e:clean-cache": "node scripts/e2e/clean-cache.js",
    "diagnose-modules": "node scripts/diagnose-modules.js",
    "build": "node scripts/run-with-node22.js \"turbo run build --no-daemon\"",
    "lint": "node scripts/run-with-node22.js \"turbo run lint --no-daemon\"",
    "lint-staged": "lint-staged",
    "clean": "turbo run clean",
    "type-check": "node scripts/run-with-node22.js \"turbo run type-check --no-daemon\"",
    "validate": "node scripts/validate-env.js --verbose",
    "kill-ports": "node scripts/kill-port.js 3000 4001",
    "check-ports": "node scripts/check-port.js 3000 && node scripts/check-port.js 4001",
    "backup": "node scripts/run-with-node22.js \"node scripts/backup-db.js\"",
    "backup:compress": "node scripts/run-with-node22.js \"node scripts/backup-db.js --compress\"",
    "restore": "node scripts/run-with-node22.js \"node scripts/restore-db.js\"",
    "migrate:to-local": "node scripts/run-with-node22.js \"node node_modules/tsx/dist/cli.mjs scripts/migrate-to-local-storage.ts\"",
    "migrate:to-local:dry-run": "node scripts/run-with-node22.js \"node node_modules/tsx/dist/cli.mjs scripts/migrate-to-local-storage.ts --dry-run\"",
    "prepare": "husky install",
    "commitlint": "commitlint",
    "unlock:all": "node scripts/clear-lockouts.js",
    "unlock": "node scripts/unlock-account.js",
    "factory-reset": "node scripts/run-with-node22.js \"node node_modules/tsx/dist/cli.mjs apps/api/src/scripts/factory-reset.ts\"",
    "node:check": "node scripts/check-node-version.js",
    "doctor:runtime": "node scripts/runtime-doctor.js",
    "sqlite:check": "node scripts/sqlite-check.js",
    "sqlite:backup": "node scripts/run-with-node22.js \"node scripts/backup-db.js\"",
    "preinstall": "npm run -s node:check",
    "predev": "npm run -s node:check",
    "pretest": "npm run -s node:check",
    "prebuild": "npm run -s node:check",
    "prelint": "npm run -s node:check",
    "pretype-check": "npm run -s node:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@playwright/test": "^1.56.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.1.1",
    "sharp": "^0.34.4",
    "tsx": "^4.20.6",
    "turbo": "^1.13.4",
    "typescript": "^5.9.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@sentry-internal/replay-canvas": "^10.37.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.6.2",
    "canonicalize": "^2.1.0",
    "fast-check": "^4.3.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "postcss": "^8.5.6"
  },
  "overrides": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "nanoid": "^3.3.7",
    "@rolldown/pluginutils": "1.0.0-beta.27"
  }
}
