{
  "name": "keimenon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install && npm run check-ports && npm run prepare && echo \n✅ Setup complete! Run 'npm run dev' to start.",
    "dev": "node scripts/dev.js",
    "dev:clean": "node scripts/dev.js --clean",
    "dev:stop": "node scripts/dev-stop.js",
    "cleanup:dev": "node scripts/cleanup-dev.js",
    "test": "turbo run test",
    "test:auth": "node tests/auth-suite.js",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:firefox": "playwright test --project=firefox",
    "e2e:webkit": "playwright test --project=webkit --workers=1",
    "e2e:smoke": "playwright test tests/e2e/smoke.spec.ts tests/e2e/keimenon-operations.spec.ts tests/e2e/flow-auth-keimenon.spec.ts tests/e2e/settings-navigation.spec.ts --project=chromium --workers=2",
    "e2e:smoke:ui": "playwright test tests/e2e/smoke.spec.ts tests/e2e/keimenon-operations.spec.ts tests/e2e/flow-auth-keimenon.spec.ts tests/e2e/settings-navigation.spec.ts --project=chromium --ui",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:install": "playwright install --with-deps",
    "e2e:report": "playwright show-report",
    "e2e:dev": "node scripts/e2e/dev.js",
    "e2e:clean": "node scripts/cleanup-test-data.js",
    "e2e:clean-cache": "node scripts/e2e/clean-cache.js",
    "diagnose-modules": "node scripts/diagnose-modules.js",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint-staged": "lint-staged",
    "clean": "turbo run clean",
    "type-check": "turbo run type-check",
    "validate": "node scripts/validate-env.js --verbose",
    "kill-ports": "node scripts/kill-port.js 3000 4001",
    "check-ports": "node scripts/check-port.js 3000 && node scripts/check-port.js 4001",
    "backup": "node scripts/backup-db.js",
    "backup:compress": "node scripts/backup-db.js --compress",
    "restore": "node scripts/restore-db.js",
    "migrate:to-local": "npx tsx scripts/migrate-to-local-storage.ts",
    "migrate:to-local:dry-run": "npx tsx scripts/migrate-to-local-storage.ts --dry-run",
    "prepare": "husky install",
    "commitlint": "commitlint",
    "unlock:all": "node scripts/clear-lockouts.js",
    "unlock": "node scripts/unlock-account.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@playwright/test": "^1.56.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.10",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.1.1",
    "sharp": "^0.34.4",
    "tsx": "^4.20.6",
    "turbo": "^1.13.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "canonicalize": "^2.1.0",
    "fast-check": "^4.3.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  }
}
